{
  "name": "terminal-browser",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "bash ../scripts/fetch-electron.sh",
    "build": "tsc -p tsconfig.json",
    "build:engine": "pnpm --filter pixel-react build",
    "start": "pnpm build:engine && pnpm build && pnpm --filter terminal-browser-cli build && exec node ../cli/dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pixel-react": "workspace:*",
    "pixel-store": "workspace:*",
    "pixel-terminals": "workspace:*",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "electron": "43.3.0",
    "typescript": "^5.5.0"
  }
}
