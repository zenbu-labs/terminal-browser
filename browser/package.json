{
  "name": "terminal-browser",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "bash ../scripts/copy-react-grab.sh",
    "build": "tsc -p tsconfig.json",
    "start": "pnpm build && pnpm --filter terminal-browser-cli build && exec node ../cli/dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@zenbu-labs/pixel": "workspace:*",
    "pele": "1.12.0",
    "react": "^18.3.1",
    "react-grab": "0.2.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shared": "workspace:*",
    "unified": "11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/hast": "3.0.5",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "typescript": "^5.5.0"
  }
}
