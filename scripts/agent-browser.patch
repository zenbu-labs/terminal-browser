+//! In terminal-browser builds, files agent-browser writes can't be redirected by
+//! another user: a link or file they planted on the way (in /tmp, say) is refused.
+//! Relative paths mean the caller's working folder.
+
+use std::os::unix::fs::MetadataExt;
+use std::path::{Path, PathBuf};
+
+use serde_json::Value;
+
+const PATH_KEYS: &[&str] = &[
+    "path",
+    "output",
+    "file",
+    "baseline",
+    "screenshotDir",
+    "downloadPath",
+    "storageState",
+    "caCert",
+    "profile",
+    "executablePath",
+];
+const PATH_LIST_KEYS: &[&str] = &["files", "extensions", "initScripts"];
+
+fn paths_mut(cmd: &mut Value) -> Vec<&mut Value> {
+    let mut found = Vec::new();
+    let Some(object) = cmd.as_object_mut() else {
+        return found;
+    };
+    for (key, value) in object.iter_mut() {
+        if PATH_KEYS.contains(&key.as_str()) && value.is_string() {
+            found.push(value);
+        } else if PATH_LIST_KEYS.contains(&key.as_str()) {
+            if let Some(list) = value.as_array_mut() {
+                found.extend(list.iter_mut().filter(|item| item.is_string()));
+            }
+        }
+    }
+    found
+}
+
+/// Run by the command line before a command is sent, so relative paths mean the
+/// caller's working folder rather than wherever the daemon was started.
+pub fn absolutize_paths(cmd: &mut Value) {
+    let Ok(cwd) = std::env::current_dir() else {
+        return;
+    };
+    for value in paths_mut(cmd) {
+        let raw = value.as_str().unwrap_or_default();
+        if !raw.is_empty() && Path::new(raw).is_relative() {
+            *value = Value::String(cwd.join(raw).to_string_lossy().into_owned());
+        }
+    }
+}
+
+// fixme: placeholder copy
+const PLANTED: &str = "another user owns a link or file on this path";
+
+// A link on the way to `path`, or the file at its end, that belongs to someone
+// other than us or root, so writing there would go where that user chose.
+fn planted_by_another_user(path: &Path, uid: u32) -> bool {
+    let mut at = PathBuf::new();
+    for component in path.components() {
+        at.push(component);
+        let Ok(meta) = std::fs::symlink_metadata(&at) else {
+            return false;
+        };
+        let foreign = meta.uid() != uid && meta.uid() != 0;
+        if meta.file_type().is_symlink() && foreign {
+            return true;
+        }
+        if at.as_path() == path && !meta.is_dir() && foreign {
+            return true;
+        }
+    }
+    false
+}
+
+/// Run by the daemon on every command.
+pub fn check_command_paths(cmd: &Value) -> Result<(), String> {
+    let uid = unsafe { libc::geteuid() };
+    let mut owned = cmd.clone();
+    for value in paths_mut(&mut owned) {
+        let raw = value.as_str().unwrap_or_default();
+        if Path::new(raw).is_absolute() && planted_by_another_user(Path::new(raw), uid) {
+            return Err(format!("{}: {}", PLANTED, raw));
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn scratch(name: &str) -> PathBuf {
+        let root = std::env::temp_dir()
+            .canonicalize()
+            .unwrap()
+            .join(format!("ab-local-paths-{}-{}", name, std::process::id()));
+        let _ = std::fs::remove_dir_all(&root);
+        std::fs::create_dir_all(&root).unwrap();
+        root
+    }
+
+    #[test]
+    fn relative_paths_mean_the_callers_working_folder() {
+        let cwd = std::env::current_dir().unwrap();
+        let mut cmd = serde_json::json!({
+            "action": "upload", "selector": "#f", "files": ["a.txt", "/abs/b.txt"], "path": "shot.png", "url": "x"
+        });
+        absolutize_paths(&mut cmd);
+        assert_eq!(cmd["files"][0], cwd.join("a.txt").to_string_lossy().as_ref());
+        assert_eq!(cmd["files"][1], "/abs/b.txt");
+        assert_eq!(cmd["path"], cwd.join("shot.png").to_string_lossy().as_ref());
+        assert_eq!(cmd["url"], "x");
+    }
+
+    #[test]
+    fn links_and_files_another_user_planted_are_refused() {
+        let root = scratch("planted");
+        let ours = unsafe { libc::geteuid() };
+        let someone_else = ours + 1;
+        std::os::unix::fs::symlink(root.join("victim"), root.join("link.png")).unwrap();
+        std::fs::write(root.join("existing.json"), b"{}").unwrap();
+        std::os::unix::fs::symlink(&root, root.join("dir")).unwrap();
+
+        assert!(planted_by_another_user(&root.join("link.png"), someone_else));
+        assert!(planted_by_another_user(&root.join("existing.json"), someone_else));
+        assert!(planted_by_another_user(&root.join("dir/new.png"), someone_else));
+        assert!(!planted_by_another_user(&root.join("new.png"), someone_else));
+
+        assert!(!planted_by_another_user(&root.join("link.png"), ours));
+        assert!(!planted_by_another_user(&root.join("existing.json"), ours));
+        assert!(check_command_paths(&serde_json::json!({ "action": "screenshot", "path": root.join("link.png") })).is_ok());
+        let _ = std::fs::remove_dir_all(&root);
+    }
+
+    // Every key a command carries into the daemon is either checked as a path here,
+    // or listed as not naming a file. A new upstream key fails this until it is sorted.
+    const NOT_PATHS: &[&str] = &[
+        "abort", "accept", "accuracy", "action", "allowFileAccess", "allowedDomains", "amount",
+        "annotate", "args", "attribute", "autoConnect", "body", "button", "buttons", "categories",
+        "cdpPort", "cdpUrl", "clear", "clearCaCert", "clickCount", "code", "colorScheme", "compact",
+        "contactSheet", "contactSheetThreshold", "content", "cookies", "credentialItem",
+        "credentialProvider", "css", "cursor", "days", "defaultInputMode", "delay", "delta", "deltaX",
+        "deltaY", "detach", "device", "deviceName", "deviceScaleFactor", "direction", "distance",
+        "duration", "endX", "endY", "engine", "event", "eventInit", "eventType", "exact", "expression",
+        "features", "fiberId", "filter", "format", "fps", "frameId", "full", "fullPage", "function",
+        "headers", "headless", "height", "hideScrollbars", "html", "id", "identifier", "ifChanged",
+        "ignoreHTTPSErrors", "index", "inputMode", "interactive", "invocationId", "json", "key", "label",
+        "landscape", "latitude", "llms", "loadState", "locale", "longitude", "maxDepth", "maxHeight",
+        "maxWidth", "media", "method", "mobile", "modifiers", "name", "newTab", "noNavigate", "noXvfb",
+        "offline", "onlyDynamic", "operation", "params", "password", "passwordSelector", "permissions",
+        "pinTab", "platformVersion", "plugins", "port", "preferCSSPageSize", "printBackground",
+        "promptText", "properties", "provider", "proxy", "quality", "reducedMotion", "requestId",
+        "requireMd", "resourceType", "resourceTypes", "response", "restoreCheckFn", "restoreCheckText",
+        "restoreCheckUrl", "restoreKey", "restoreSave", "role", "script", "seed", "selector", "source",
+        "startX", "startY", "state", "status", "steps", "subAction", "subaction", "submitSelector",
+        "tabId", "tags", "target", "text", "threshold", "timeout", "timezone", "timezoneId", "tool",
+        "touchPoints", "type", "udid", "url", "url1", "url2", "urls", "userAgent", "username",
+        "usernameSelector", "value", "values", "viewport", "waitUntil", "webgpu", "webmcp", "width",
+        "x", "y",
+    ];
+
+    fn sources(dir: &Path) -> Vec<(PathBuf, String)> {
+        let mut out = Vec::new();
+        for entry in std::fs::read_dir(dir).unwrap().flatten() {
+            let path = entry.path();
+            if path.is_dir() {
+                out.extend(sources(&path));
+            } else if path.extension().is_some_and(|e| e == "rs") {
+                let text = std::fs::read_to_string(&path).unwrap();
+                out.push((path, text.split("#[cfg(test)]").next().unwrap().to_string()));
+            }
+        }
+        out
+    }
+
+    fn command_keys(text: &str) -> Vec<String> {
+        let mut keys = Vec::new();
+        let mut rest = text;
+        while let Some(at) = rest.find("cmd") {
+            let after = rest[at + 3..].trim_start();
+            if let Some(tail) = after.strip_prefix(".get(\"") {
+                if let Some(end) = tail.find('"') {
+                    let key = &tail[..end];
+                    if !key.is_empty() && key.chars().all(|c| c.is_ascii_alphanumeric() || c == '_') {
+                        keys.push(key.to_string());
+                    }
+                }
+            }
+            rest = &rest[at + 3..];
+        }
+        keys
+    }
+
+    #[test]
+    fn every_key_a_command_carries_is_sorted_into_paths_or_not() {
+        let native = Path::new(env!("CARGO_MANIFEST_DIR")).join("src/native");
+        let mut unsorted = Vec::new();
+        for (path, text) in sources(&native) {
+            for key in command_keys(&text) {
+                let known = PATH_KEYS.contains(&key.as_str())
+                    || PATH_LIST_KEYS.contains(&key.as_str())
+                    || NOT_PATHS.contains(&key.as_str());
+                if !known {
+                    unsorted.push(format!("{}: {}", path.display(), key));
+                }
+            }
+        }
+        assert!(unsorted.is_empty(), "command keys nobody has sorted: {:?}", unsorted);
+    }
+}
