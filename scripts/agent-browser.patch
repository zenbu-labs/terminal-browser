+fn read_args_from_fd(fd: &str) -> Result<Vec<String>, String> {
+    use std::io::Read as _;
+    use std::os::fd::FromRawFd as _;
+    let fd: i32 = fd.parse().map_err(|_| "AGENT_BROWSER_ARGS_FD is not a descriptor".to_string())?;
