+    // A node is near the viewport while its rect, grown by its margin, overlaps what its scroll area shows.
+    pub(crate) fn take_viewport_changes(&mut self) -> Vec<(NodeId, bool)> {
+        let mut changes = Vec::new();
+        let mut watched = std::mem::take(&mut self.viewport_watch);
+        watched.retain(|&id| self.get(id).is_some_and(|node| node.viewport_margin.is_some()));
+        for &id in &watched {
+            let near = self.near_viewport(id);
+            let node = self.node_mut(id);
+            if node.near_viewport != Some(near) {
+                node.near_viewport = Some(near);
+                changes.push((id, near));
+            }
+        }
+        self.viewport_watch = watched;
+        changes
+    }
+
+    fn near_viewport(&self, id: NodeId) -> bool {
+        let Some(node) = self.get(id) else {
+            return false;
+        };
+        let margin = node.viewport_margin.unwrap_or(0.0);
+        let Some(rect) = self.rect(id).filter(|r| r.w > 0.0 && r.h > 0.0) else {
+            return false;
+        };
+        let mut area = self.get(self.root).map_or(PxRect::ZERO, |root| root.visible);
+        let mut current = node.parent;
+        while let Some(ancestor) = current {
+            let Some(parent) = self.get(ancestor) else {
+                break;
+            };
+            if parent.style.overflow == Overflow::Scroll {
+                area = parent.visible;
+                break;
+            }
+            current = parent.parent;
+        }
+        rect.outset(margin).intersects(area)
+    }
+
