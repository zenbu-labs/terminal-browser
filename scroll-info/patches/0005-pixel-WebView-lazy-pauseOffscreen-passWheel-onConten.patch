new file mode 100644
index 00000000..3df09e80
--- /dev/null
+++ b/pixel/packages/pixel/src/web/content-height.ts
@@ -0,0 +1,73 @@
+const BINDING = "__pixelContentHeight";
+const WORLD = "pixel-content-height";
+
+// A page shorter than its window reports its own height; a longer one reports how far it scrolls.
+const PAGE_SCRIPT = `(() => {
+  let last = -1;
+  const send = () => {
+    const root = document.documentElement;
+    if (!root) return;
+    const height = Math.ceil(root.scrollHeight > root.clientHeight ? root.scrollHeight : root.getBoundingClientRect().height);
+    if (height === last) return;
+    last = height;
+    ${BINDING}(String(height));
+  };
+  const observer = new ResizeObserver(send);
+  const watch = () => {
+    if (document.documentElement) observer.observe(document.documentElement);
+    if (document.body) observer.observe(document.body);
+    send();
+  };
+  watch();
+  document.addEventListener("DOMContentLoaded", watch);
+  addEventListener("load", send);
+  if (document.fonts) document.fonts.addEventListener("loadingdone", send);
+})()`;
+
+export class PageHeight {
+  private started = false;
+  private starting: Promise<void> | null = null;
+  private stopped = false;
+
+  constructor(
+    private readonly contents: () => Electron.WebContents,
+    private readonly cdp: (method: string, params?: Record<string, unknown>) => Promise<Record<string, unknown>>,
+    private readonly onHeight: (cssHeight: number) => void,
+  ) {}
+
+  private readonly onMessage = (_event: unknown, method: string, params: unknown) => {
+    if (method !== "Runtime.bindingCalled" || this.stopped) return;
+    const call = params as { name: string; payload: string };
+    if (call.name !== BINDING) return;
+    const height = Number(call.payload);
+    if (Number.isFinite(height) && height >= 0) this.onHeight(height);
+  };
+
+  // Safe to call again until it has worked once: a page that has no renderer yet can't be reached.
+  start(): Promise<void> {
+    if (this.started || this.stopped) return Promise.resolve();
+    this.starting ??= (async () => {
+      // Listen first: the script runs right away in the page already showing and reports its height once.
+      this.contents().debugger.on("message", this.onMessage);
+      try {
+        await this.cdp("Runtime.addBinding", { name: BINDING, executionContextName: WORLD });
+        await this.cdp("Page.addScriptToEvaluateOnNewDocument", { source: PAGE_SCRIPT, worldName: WORLD, runImmediately: true });
+        this.started = true;
+      } catch (error) {
+        this.contents().debugger.removeListener("message", this.onMessage);
+        throw error;
+      } finally {
+        this.starting = null;
+      }
+    })();
+    return this.starting;
+  }
+
+  stop(): void {
+    if (this.stopped) return;
+    this.stopped = true;
+    try {
+      this.contents().debugger.removeListener("message", this.onMessage);
+    } catch {}
+  }
+}
