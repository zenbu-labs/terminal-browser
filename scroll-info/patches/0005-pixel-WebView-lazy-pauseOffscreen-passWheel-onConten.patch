diff --git a/pixel/packages/pixel/test/page-pause.test.js b/pixel/packages/pixel/test/page-pause.test.js
new file mode 100644
index 00000000..ccdfeeaa
--- /dev/null
+++ b/pixel/packages/pixel/test/page-pause.test.js
@@ -0,0 +1,82 @@
+const assert = require("node:assert/strict");
+const { test } = require("node:test");
+
+const { PagePause } = require("../dist/web/pause.js");
+
+function page() {
+  const calls = [];
+  let resumed = 0;
+  const contents = {
+    setBackgroundThrottling: (allowed) => calls.push(`throttle ${allowed}`),
+    stopPainting: () => calls.push("stop painting"),
+    startPainting: () => calls.push("start painting"),
+  };
+  const pause = new PagePause({
+    contents: () => contents,
+    cdp: async (method, params) => calls.push(`${method} ${params.state}`),
+    onResumed: () => resumed++,
+  });
+  return { pause, calls, resumed: () => resumed };
+}
+
+const settle = () => new Promise((resolve) => setImmediate(resolve));
+
+test("pausing throttles the page before freezing it, since Chromium won't freeze an unthrottled page", async () => {
+  const { pause, calls } = page();
+  pause.set(true);
+  await settle();
+  assert.deepEqual(calls, ["throttle true", "stop painting", "Page.setWebLifecycleState frozen"]);
+});
+
+test("resuming unthrottles, unfreezes, then paints again", async () => {
+  const { pause, calls, resumed } = page();
+  pause.set(true);
+  await settle();
+  calls.length = 0;
+  pause.set(false);
+  await settle();
+  assert.deepEqual(calls, ["throttle false", "Page.setWebLifecycleState active", "start painting"]);
+  assert.equal(resumed(), 1);
+});
+
+test("a page paused again before it finished resuming stays paused and doesn't paint", async () => {
+  const { pause, calls, resumed } = page();
+  pause.set(true);
+  pause.set(false);
+  pause.set(true);
+  await settle();
+  assert.equal(pause.isPaused, true);
+  assert.ok(!calls.includes("start painting"));
+  assert.equal(calls.at(-1), "Page.setWebLifecycleState frozen");
+  assert.equal(resumed(), 0);
+});
+
+test("asking for the state it is already in does nothing", async () => {
+  const { pause, calls } = page();
+  pause.set(false);
+  await settle();
+  assert.deepEqual(calls, []);
+});
+
+test("a resume can't overtake a freeze that is still waiting to be sent", async () => {
+  const sent = [];
+  let releaseFirst;
+  const firstCall = new Promise((resolve) => (releaseFirst = resolve));
+  let calls = 0;
+  const contents = { setBackgroundThrottling() {}, stopPainting() {}, startPainting() {} };
+  const pause = new PagePause({
+    contents: () => contents,
+    cdp: async (_method, params) => {
+      if (calls++ === 0) await firstCall;
+      sent.push(params.state);
+    },
+    onResumed() {},
+  });
+  pause.set(true);
+  pause.set(false);
+  await settle();
+  releaseFirst();
+  await settle();
+  await settle();
+  assert.deepEqual(sent, ["frozen", "active"]);
+});
