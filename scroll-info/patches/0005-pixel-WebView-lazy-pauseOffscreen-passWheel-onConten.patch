diff --git a/pixel/packages/pixel/src/web/pause.ts b/pixel/packages/pixel/src/web/pause.ts
new file mode 100644
index 00000000..194af641
--- /dev/null
+++ b/pixel/packages/pixel/src/web/pause.ts
@@ -0,0 +1,48 @@
+export interface PausableContents {
+  setBackgroundThrottling(allowed: boolean): void;
+  stopPainting(): void;
+  startPainting(): void;
+}
+
+export interface PagePauseOptions {
+  contents: () => PausableContents;
+  cdp: (method: string, params?: Record<string, unknown>) => Promise<unknown>;
+  onResumed: () => void;
+}
+
+// A paused page keeps its state but stops drawing and running its scripts until it is resumed.
+// Chromium only freezes a page that is allowed to be throttled, so throttling stays on while paused.
+export class PagePause {
+  private paused = false;
+  // Lifecycle commands go out one at a time, so a quick pause and resume can't reach the page out of order.
+  private lifecycle: Promise<unknown> = Promise.resolve();
+
+  constructor(private readonly options: PagePauseOptions) {}
+
+  get isPaused(): boolean {
+    return this.paused;
+  }
+
+  set(paused: boolean) {
+    if (this.paused === paused) return;
+    this.paused = paused;
+    const contents = this.options.contents();
+    if (paused) {
+      contents.setBackgroundThrottling(true);
+      contents.stopPainting();
+      void this.setLifecycle("frozen");
+      return;
+    }
+    contents.setBackgroundThrottling(false);
+    void this.setLifecycle("active").then(() => {
+      if (this.paused) return;
+      contents.startPainting();
+      this.options.onResumed();
+    });
+  }
+
+  private setLifecycle(state: "frozen" | "active"): Promise<unknown> {
+    this.lifecycle = this.lifecycle.then(() => this.options.cdp("Page.setWebLifecycleState", { state }).catch(() => {}));
+    return this.lifecycle;
+  }
+}
