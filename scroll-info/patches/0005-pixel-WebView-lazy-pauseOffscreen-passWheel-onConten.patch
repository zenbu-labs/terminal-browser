+#[test]
+fn viewport_changes_follow_scrolling_with_a_margin() {
+    let mut fonts = crate::fonts::FontRegistry::bundled();
+    let block = |i: usize| Desc {
+        key: Some(format!("b{i}")),
+        style: Style {
+            height: Dimension::Px(50.0),
+            flex_shrink: 0.0,
+            ..Style::default()
+        },
+        viewport_margin: Some(20.0),
+        ..Desc::default()
+    };
+    let mut tree = tree_of(
+        (300.0, 300.0),
+        vec![Desc {
+            key: Some("scroller".into()),
+            style: Style {
+                flex_direction: FlexDirection::Column,
+                width: Dimension::Px(100.0),
+                height: Dimension::Px(100.0),
+                flex_shrink: 0.0,
+                overflow: Overflow::Scroll,
+                ..Style::default()
+            },
+            children: (0..8).map(block).collect(),
+            ..Desc::default()
+        }],
+    );
+    let near = |tree: &mut Tree| {
+        let mut changes: Vec<(String, bool)> = tree
+            .take_viewport_changes()
+            .into_iter()
+            .map(|(id, near)| (tree.key_of(id).unwrap().to_string(), near))
+            .collect();
+        changes.sort();
+        changes
+    };
+    let named = |pairs: &[(&str, bool)]| pairs.iter().map(|(k, v)| (k.to_string(), *v)).collect::<Vec<_>>();
+    assert_eq!(
+        near(&mut tree),
+        named(&[("b0", true), ("b1", true), ("b2", true), ("b3", false), ("b4", false), ("b5", false), ("b6", false), ("b7", false)])
+    );
+    assert!(near(&mut tree).is_empty(), "nothing moved, so nothing changes");
+
+    let scroller = tree.find("scroller").unwrap();
+    tree.scroll_state_mut(scroller).unwrap().position = 200.0;
+    tree.mark_place();
+    tree.flush_layout(&mut fonts, 16.0);
+    assert_eq!(
+        near(&mut tree),
+        named(&[("b0", false), ("b1", false), ("b2", false), ("b3", true), ("b4", true), ("b5", true), ("b6", true)])
+    );
+
+    let b4 = tree.find("b4").unwrap();
+    tree.remove(b4);
+    tree.flush_layout(&mut fonts, 16.0);
+    let after_remove = near(&mut tree);
+    assert!(after_remove.iter().all(|(key, _)| key != "b4"), "{after_remove:?}");
+}
