   params.override_user_agent = content::NavigationController::UA_OVERRIDE_TRUE;
 
+  // A navigation started on behalf of another origin, such as an extension's
+  // tabs.update(), is treated like that origin started it from a page: the
+  // initiator's navigation rules apply and it carries no user activation.
+  GURL initiator;
+  if (options.Get("initiatorOrigin", &initiator)) {
+    url::Origin initiator_origin = url::Origin::Create(initiator);
+    if (initiator_origin.opaque()) {
+      Emit("did-fail-load", static_cast<int>(net::ERR_INVALID_ARGUMENT),
+           net::ErrorToShortString(net::ERR_INVALID_ARGUMENT),
+           url.possibly_invalid_spec(), true);
+      return;
+    }
+    params.is_renderer_initiated = true;
+    params.initiator_origin = initiator_origin;
+    params.source_site_instance = content::SiteInstance::CreateForURL(
+        web_contents()->GetBrowserContext(), initiator_origin.GetURL());
+    params.transition_type = ui::PAGE_TRANSITION_FROM_API;
+  }
