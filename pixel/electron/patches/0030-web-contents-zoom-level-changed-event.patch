diff --git a/shell/browser/api/electron_api_web_contents.cc b/shell/browser/api/electron_api_web_contents.cc
--- a/shell/browser/api/electron_api_web_contents.cc
+++ b/shell/browser/api/electron_api_web_contents.cc
@@ -1045,6 +1045,8 @@ void WebContents::InitZoomController(content::WebContents* web_contents,
                                      const gin_helper::Dictionary& options) {
   WebContentsZoomController* const zoom_controller =
       WebContentsZoomController::GetOrCreateForWebContents(web_contents);
+  if (!zoom_observation_.IsObserving())
+    zoom_observation_.Observe(zoom_controller);
 
   double zoom_factor = 0;
   if (options.Get(options::kZoomFactor, &zoom_factor))
@@ -1730,6 +1732,26 @@ void WebContents::ContentsZoomChange(bool zoom_in) {
   Emit("zoom-changed", std::string_view{zoom_in ? "in" : "out"});
 }
 
+void WebContents::OnZoomControllerDestroyed(
+    WebContentsZoomController* zoom_controller) {
+  zoom_observation_.Reset();
+}
+
+void WebContents::OnZoomChanged(
+    const WebContentsZoomController::ZoomChangedEventData& data) {
+  if (data.old_zoom_level == data.new_zoom_level)
+    return;
+  v8::Isolate* isolate = JavascriptEnvironment::GetIsolate();
+  v8::HandleScope handle_scope(isolate);
+  Emit("zoom-level-changed",
+       gin::DataObjectBuilder(isolate)
+           .Set("oldZoomFactor",
+                blink::ZoomLevelToZoomFactor(data.old_zoom_level))
+           .Set("newZoomFactor",
+                blink::ZoomLevelToZoomFactor(data.new_zoom_level))
+           .Build());
+}
+
 Profile* WebContents::GetProfile() {
   return nullptr;
 }
