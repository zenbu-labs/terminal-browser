+v8::Local<v8::Value> MediaCaptureToV8(v8::Isolate* isolate,
+                                      const MediaCaptureState& capture) {
+  auto dict = gin_helper::Dictionary::CreateEmpty(isolate);
+  dict.Set("video", capture.video);
+  dict.Set("audio", capture.audio);
+  dict.Set("display", capture.display);
