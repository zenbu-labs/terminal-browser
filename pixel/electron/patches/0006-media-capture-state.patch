+// Copyright (c) 2026 Zenbu Labs. All rights reserved.
+// Use of this source code is governed by the MIT license that can be
+// found in the LICENSE file.
+
+#ifndef ELECTRON_SHELL_BROWSER_MEDIA_MEDIA_CAPTURE_UI_H_
+#define ELECTRON_SHELL_BROWSER_MEDIA_MEDIA_CAPTURE_UI_H_
+
+#include "content/public/browser/media_stream_request.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "third_party/blink/public/mojom/mediastream/media_stream.mojom.h"
+
+namespace content {
+class WebContents;
+}
+
+namespace electron {
+
+struct MediaCaptureState {
+  bool video = false;
+  bool audio = false;
+  bool display = false;
+
+  bool operator==(const MediaCaptureState&) const = default;
+};
+
+// Counts the open capture streams of a WebContents and tells its
+// api::WebContents whenever the set of captured kinds changes.
+class MediaCaptureUsage
+    : public content::WebContentsUserData<MediaCaptureUsage> {
+ public:
+  ~MediaCaptureUsage() override;
+
+  MediaCaptureState state() const;
+  void Add(const blink::mojom::StreamDevices& devices);
+  void Remove(const blink::mojom::StreamDevices& devices);
+
+ private:
+  friend class content::WebContentsUserData<MediaCaptureUsage>;
+  explicit MediaCaptureUsage(content::WebContents* web_contents);
+
+  void Adjust(const blink::mojom::StreamDevices& devices, int delta);
+
+  int video_ = 0;
+  int audio_ = 0;
+  int display_ = 0;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+// Wraps a media response so an accepted request carries a MediaStreamUI whose
+// lifetime follows the stream, the same way Chrome's capture indicator works.
+content::MediaResponseCallback TrackMediaCapture(
+    content::WebContents* web_contents,
+    content::MediaResponseCallback callback);
+
+}  // namespace electron
+
+#endif  // ELECTRON_SHELL_BROWSER_MEDIA_MEDIA_CAPTURE_UI_H_
