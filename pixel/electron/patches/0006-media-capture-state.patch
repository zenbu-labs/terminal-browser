diff --git a/shell/browser/media/media_capture_ui.cc b/shell/browser/media/media_capture_ui.cc
new file mode 100644
--- /dev/null
+++ b/shell/browser/media/media_capture_ui.cc
@@ -0,0 +1,152 @@
+// Copyright (c) 2026 Zenbu Labs. All rights reserved.
+// Use of this source code is governed by the MIT license that can be
+// found in the LICENSE file.
+
+#include "shell/browser/media/media_capture_ui.h"
+
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "content/public/browser/web_contents.h"
+#include "shell/browser/api/electron_api_web_contents.h"
+#include "third_party/blink/public/common/mediastream/media_stream_request.h"
+
+namespace electron {
+
+namespace {
+
+using blink::mojom::MediaStreamType;
+
+enum class Kind { kNone, kVideo, kAudio, kDisplay };
+
+Kind KindOf(const std::optional<blink::MediaStreamDevice>& device) {
+  if (!device)
+    return Kind::kNone;
+  switch (device->type) {
+    case MediaStreamType::DEVICE_VIDEO_CAPTURE:
+      return Kind::kVideo;
+    case MediaStreamType::DEVICE_AUDIO_CAPTURE:
+      return Kind::kAudio;
+    case MediaStreamType::NO_SERVICE:
+    case MediaStreamType::NUM_MEDIA_TYPES:
+      return Kind::kNone;
+    default:
+      return Kind::kDisplay;
+  }
+}
+
+// Owned by the stream request: created when the embedder accepts the request
+// and destroyed when the last device of the request stops.
+class MediaCaptureUI : public content::MediaStreamUI {
+ public:
+  MediaCaptureUI(base::WeakPtr<content::WebContents> web_contents,
+                 const blink::mojom::StreamDevices& devices)
+      : web_contents_(std::move(web_contents)), devices_(devices) {}
+
+  ~MediaCaptureUI() override {
+    if (!started_ || !web_contents_)
+      return;
+    if (auto* usage = MediaCaptureUsage::FromWebContents(web_contents_.get()))
+      usage->Remove(devices_);
+  }
+
+  gfx::NativeViewId OnStarted(
+      base::RepeatingClosure stop,
+      SourceCallback source,
+      const std::string& label,
+      std::vector<content::DesktopMediaID> screen_capture_ids,
+      StateChangeCallback state_change) override {
+    if (started_ || !web_contents_)
+      return 0;
+    started_ = true;
+    MediaCaptureUsage::CreateForWebContents(web_contents_.get());
+    MediaCaptureUsage::FromWebContents(web_contents_.get())->Add(devices_);
+    return 0;
+  }
+
+  void OnDeviceStoppedForSourceChange(
+      const std::string& label,
+      const content::DesktopMediaID& old_media_id,
+      const content::DesktopMediaID& new_media_id,
+      bool captured_surface_control_active) override {}
+
+  void OnDeviceStopped(const std::string& label,
+                       const content::DesktopMediaID& media_id) override {}
+
+ private:
+  base::WeakPtr<content::WebContents> web_contents_;
+  const blink::mojom::StreamDevices devices_;
+  bool started_ = false;
+};
+
+void RespondWithTracking(base::WeakPtr<content::WebContents> web_contents,
+                         content::MediaResponseCallback callback,
+                         const blink::mojom::StreamDevicesSet& stream_devices_set,
+                         blink::mojom::MediaStreamRequestResult result,
+                         std::unique_ptr<content::MediaStreamUI> ui) {
+  if (!ui && result == blink::mojom::MediaStreamRequestResult::OK &&
+      !stream_devices_set.stream_devices.empty()) {
+    ui = std::make_unique<MediaCaptureUI>(
+        web_contents, *stream_devices_set.stream_devices[0]);
+  }
+  std::move(callback).Run(stream_devices_set, result, std::move(ui));
+}
+
+}  // namespace
+
+MediaCaptureUsage::MediaCaptureUsage(content::WebContents* web_contents)
+    : content::WebContentsUserData<MediaCaptureUsage>(*web_contents) {}
+
+MediaCaptureUsage::~MediaCaptureUsage() = default;
+
+MediaCaptureState MediaCaptureUsage::state() const {
+  return {video_ > 0, audio_ > 0, display_ > 0};
+}
+
+void MediaCaptureUsage::Add(const blink::mojom::StreamDevices& devices) {
+  Adjust(devices, 1);
+}
+
+void MediaCaptureUsage::Remove(const blink::mojom::StreamDevices& devices) {
+  Adjust(devices, -1);
+}
+
+void MediaCaptureUsage::Adjust(const blink::mojom::StreamDevices& devices,
+                               int delta) {
+  const MediaCaptureState before = state();
+  for (Kind kind : {KindOf(devices.audio_device), KindOf(devices.video_device)}) {
+    switch (kind) {
+      case Kind::kVideo:
+        video_ += delta;
+        break;
+      case Kind::kAudio:
+        audio_ += delta;
+        break;
+      case Kind::kDisplay:
+        display_ += delta;
+        break;
+      case Kind::kNone:
+        break;
+    }
+  }
+  const MediaCaptureState after = state();
+  if (after == before)
+    return;
+  if (auto* api_contents = api::WebContents::From(&GetWebContents()))
+    api_contents->OnMediaCaptureChanged(after);
+}
+
+content::MediaResponseCallback TrackMediaCapture(
+    content::WebContents* web_contents,
+    content::MediaResponseCallback callback) {
+  return base::BindOnce(&RespondWithTracking, web_contents->GetWeakPtr(),
+                        std::move(callback));
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(MediaCaptureUsage);
+
+}  // namespace electron
