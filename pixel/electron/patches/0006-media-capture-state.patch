+
+v8::Local<v8::Value> WebContents::GetMediaCapture(v8::Isolate* isolate) const {
+  MediaCaptureState capture;
+  if (auto* usage = MediaCaptureUsage::FromWebContents(web_contents()))
+    capture = usage->state();
+  return MediaCaptureToV8(isolate, capture);
+}
+
+void WebContents::OnMediaCaptureChanged(const MediaCaptureState& capture) {
+  v8::Isolate* isolate = JavascriptEnvironment::GetIsolate();
+  v8::HandleScope handle_scope(isolate);
+  Emit("media-capture-changed", MediaCaptureToV8(isolate, capture));
+}
