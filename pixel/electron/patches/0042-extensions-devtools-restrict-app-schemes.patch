-    const std::vector<std::string> app_schemes = base::SplitString(
-        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
-            switches::kStandardSchemes),
-        ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
-    if (std::ranges::find(app_schemes, document_url.GetScheme()) ==
-        app_schemes.end())
-      return false;
     if (error)
       *error = extensions::manifest_errors::kCannotAccessChromeUrl;
     return true;
@@ -95,6 +85,17 @@ class ElectronPermissionsPolicyDelegate
 
 }  // namespace
 
+std::vector<std::string> GetAppSchemesRestrictedForExtensions() {
+  std::vector<std::string> schemes = base::SplitString(
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          switches::kStandardSchemes),
+      ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  std::erase_if(schemes, [](const std::string& scheme) {
+    return URLPattern::IsValidSchemeForExtensions(scheme);
+  });
+  return schemes;
+}
