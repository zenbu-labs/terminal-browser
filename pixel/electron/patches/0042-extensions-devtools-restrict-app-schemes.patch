+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: RobPruzan <rapruzan@buffalo.edu>
+Date: Mon, 2 Nov 2026 19:57:06 -0500
+Subject: feat: let the embedder forbid schemes to DevTools extensions
+
+Electron apps register their own standard schemes for their UI (for example with protocol.registerSchemesAsPrivileged). DevTools extensions must not reach those pages, just as they may not reach chrome:// pages, so the embedder can name more schemes for the extension server to refuse.
+
+diff --git a/front_end/devtools_compatibility.js b/front_end/devtools_compatibility.js
+index 78f85604e8394f30860d1aca7d107115ac45de35..f2f429b8f61d457c7d76ede255220d78ab91a681 100644
+--- a/front_end/devtools_compatibility.js
++++ b/front_end/devtools_compatibility.js
+@@ -39,6 +39,11 @@
+      */
+     _originsForbiddenForExtensions = [];
+ 
++    /**
++     * @type {string[]}
++     */
++    _schemesForbiddenForExtensions = [];
++
+     /**
+      * @type {ExtensionDescriptor[]}
+      */
+@@ -148,6 +153,20 @@
+       return this._originsForbiddenForExtensions;
+     }
+ 
++    /**
++     * @param {string[]} forbiddenSchemes
++     */
++    setSchemesForbiddenForExtensions(forbiddenSchemes) {
++      this._schemesForbiddenForExtensions = forbiddenSchemes;
++    }
++
++    /**
++     * @returns {string[]}
++     */
++    getSchemesForbiddenForExtensions() {
++      return this._schemesForbiddenForExtensions;
++    }
++
+     /**
+      * @param {string} url
+      */
+diff --git a/front_end/panels/common/ExtensionServer.ts b/front_end/panels/common/ExtensionServer.ts
+index 8088151049cbc1ffdd7ed821bca44ee94e3e6a51..e404f95014e2d1712a9eab99b0b4b3ea4f047605 100644
+--- a/front_end/panels/common/ExtensionServer.ts
++++ b/front_end/panels/common/ExtensionServer.ts
+@@ -38,7 +38,11 @@ const kForbiddenSchemes = [
+ 
+ declare global {
+   interface Window {
+-    DevToolsAPI?: {getInspectedTabId?(): string|undefined, getOriginsForbiddenForExtensions?(): string[]};
++    DevToolsAPI?: {
++      getInspectedTabId?(): string|undefined,
++      getOriginsForbiddenForExtensions?(): string[],
++      getSchemesForbiddenForExtensions?(): string[],
++    };
+   }
+ }
+ 
+@@ -1745,6 +1749,10 @@ export class ExtensionServer extends Common.ObjectWrapper.ObjectWrapper<EventTyp
+       return false;
+     }
+ 
++    if ((window.DevToolsAPI?.getSchemesForbiddenForExtensions?.() || []).includes(parsedURL.protocol)) {
++      return false;
++    }
++
+     if ((window.DevToolsAPI?.getOriginsForbiddenForExtensions?.() || []).includes(parsedURL.origin)) {
+       return false;
+     }
