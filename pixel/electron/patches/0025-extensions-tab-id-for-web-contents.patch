+          {"sidePanel", extensions::mojom::ViewType::kExtensionSidePanel},
+          {"tab", extensions::mojom::ViewType::kTabContents},
+      });
+  auto* type = base::FindOrNull(kViewTypes, view_type);
+  if (!type || !web_contents ||
+      web_contents->GetBrowserContext() != browser_context())
+    return false;
