+int GetElectronTabId(content::WebContents* web_contents) {
+  auto* contents =
+      web_contents ? electron::api::WebContents::From(web_contents) : nullptr;
+  if (!contents ||
+      contents->type() == electron::api::WebContents::Type::kRemote ||
+      contents->type() == electron::api::WebContents::Type::kBackgroundPage)
+    return extension_misc::kUnknownTabId;
+  switch (GetViewType(web_contents)) {
+    case mojom::ViewType::kInvalid:
+    case mojom::ViewType::kTabContents:
+      return contents->ID();
+    default:
+      return extension_misc::kUnknownTabId;
+  }
+}
