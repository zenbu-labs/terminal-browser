+void ElectronExtensionWebContentsObserver::SetViewType(
+    mojom::ViewType view_type) {
+  extensions::SetViewType(web_contents(), view_type);
+  web_contents()->ForEachRenderFrameHost(
+      [this, view_type](content::RenderFrameHost* render_frame_host) {
+        if (!render_frame_host->IsRenderFrameLive())
+          return;
+        if (auto* local_frame = GetLocalFrame(render_frame_host))
+          local_frame->NotifyRenderViewType(view_type);
+      });
+}
+
+// Matched declarativeNetRequest rules belong to the document they matched in,
+// as in Chrome's ExtensionActionRunner.
+void ElectronExtensionWebContentsObserver::DidFinishNavigation(
+    content::NavigationHandle* navigation_handle) {
+  ExtensionWebContentsObserver::DidFinishNavigation(navigation_handle);
+  auto* rules_monitor_service =
+      declarative_net_request::RulesMonitorService::Get(
+          web_contents()->GetBrowserContext());
+  if (!rules_monitor_service || navigation_handle->IsSameDocument())
+    return;
+  auto& action_tracker = rules_monitor_service->action_tracker();
+  int tab_id = GetElectronTabId(web_contents());
+  if (!navigation_handle->IsInPrimaryMainFrame() ||
+      !navigation_handle->HasCommitted() ||
+      tab_id == extension_misc::kUnknownTabId) {
+    action_tracker.ClearPendingNavigation(navigation_handle->GetNavigationId());
+    return;
+  }
+  tracked_tab_id_ = tab_id;
+  action_tracker.ResetTrackedInfoForTab(tab_id,
+                                        navigation_handle->GetNavigationId());
+}
+
+void ElectronExtensionWebContentsObserver::WebContentsDestroyed() {
+  auto* rules_monitor_service =
+      declarative_net_request::RulesMonitorService::Get(
+          web_contents()->GetBrowserContext());
+  if (rules_monitor_service &&
+      tracked_tab_id_ != extension_misc::kUnknownTabId)
+    rules_monitor_service->action_tracker().ClearTabData(tracked_tab_id_);
+}
+
 WEB_CONTENTS_USER_DATA_KEY_IMPL(ElectronExtensionWebContentsObserver);
 
 }  // namespace extensions
