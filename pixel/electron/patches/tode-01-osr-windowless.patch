+
+void WebContents::SetOffscreenFocus(bool focus) {
+  if (!IsOffScreen())
+    return;
+  // What BrowserWindow's focusOnWebView() and blurWebView() do; a windowless
+  // page has no window to call them on.
+  auto* rwh = web_contents()->GetRenderViewHost()->GetWidget();
+  if (focus)
+    rwh->Focus();
+  else
+    rwh->Blur();
+}
