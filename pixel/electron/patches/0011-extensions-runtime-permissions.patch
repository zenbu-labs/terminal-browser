+v8::Local<v8::Promise> Extensions::SetRuntimePermissions(
+    v8::Isolate* isolate,
+    const std::string& extension_id,
+    gin_helper::Dictionary granted) {
+  gin_helper::Promise<void> promise(isolate);
+  v8::Local<v8::Promise> handle = promise.GetHandle();
+
+  const extensions::Extension* extension =
+      extensions::ExtensionRegistry::Get(browser_context())
+          ->enabled_extensions()
+          .GetByID(extension_id);
+  if (!extension) {
+    promise.RejectWithErrorMessage("No enabled extension with id " +
+                                   extension_id);
+    return handle;
+  }
+
+  std::vector<std::string> api_names;
+  std::vector<std::string> origins;
+  granted.Get("permissions", &api_names);
+  granted.Get("origins", &origins);
+
+  const extensions::PermissionSet& optional =
+      extensions::PermissionsParser::GetOptionalPermissions(extension);
+
+  extensions::APIPermissionSet apis;
+  for (const std::string& name : api_names) {
+    const extensions::APIPermissionInfo* info =
+        extensions::PermissionsInfo::GetInstance()->GetByName(name);
+    if (info && optional.HasAPIPermission(info->id()))
+      apis.insert(info->id());
+  }
+
+  // Mirrors how chrome.permissions.request parses origins: only patterns
+  // inside the manifest's optional hosts can be granted.
+  const bool allow_file_access =
+      extensions::util::AllowFileAccess(extension_id, browser_context());
+  extensions::URLPatternSet hosts;
+  for (const std::string& origin : origins) {
+    URLPattern pattern(extensions::Extension::kValidHostPermissionSchemes);
+    if (pattern.Parse(origin) != URLPattern::ParseResult::kSuccess)
+      continue;
+    if (!allow_file_access) {
+      if (pattern.scheme() == url::kFileScheme)
+        continue;
+      pattern.SetValidSchemes(pattern.valid_schemes() &
+                              ~URLPattern::SCHEME_FILE);
+    }
+    if (optional.explicit_hosts().ContainsPattern(pattern))
+      hosts.AddPattern(pattern);
+  }
+
+  const extensions::PermissionSet wanted(
+      std::move(apis), extensions::ManifestPermissionSet(), std::move(hosts),
+      extensions::URLPatternSet());
+  const extensions::PermissionSet& active =
+      extension->permissions_data()->active_permissions();
+  std::unique_ptr<const extensions::PermissionSet> to_add =
+      extensions::PermissionSet::CreateDifference(wanted, active);
+  std::unique_ptr<const extensions::PermissionSet> to_remove =
+      extensions::PermissionSet::CreateIntersection(
+          *extensions::PermissionSet::CreateDifference(
+              *extensions::PermissionSet::CreateDifference(
+                  active,
+                  extensions::PermissionsParser::GetRequiredPermissions(
+                      extension)),
+              wanted),
+          optional);
+
+  base::RepeatingClosure done = base::BarrierClosure(
+      2, base::BindOnce(
+             [](gin_helper::Promise<void> promise) { promise.Resolve(); },
+             std::move(promise)));
+  extensions::PermissionsUpdater updater(browser_context());
+  if (to_add->IsEmpty())
+    done.Run();
+  else
+    updater.GrantOptionalPermissions(*extension, *to_add, done);
+  if (to_remove->IsEmpty())
+    done.Run();
+  else
+    updater.RevokeOptionalPermissions(
+        *extension, *to_remove,
+        extensions::PermissionsUpdater::RemoveType::kSoft, done);
+  return handle;
+}
+
+v8::Local<v8::Value> Extensions::GetActivePermissions(
+    v8::Isolate* isolate,
+    const std::string& extension_id) {
+  const extensions::Extension* extension =
+      extensions::ExtensionRegistry::Get(browser_context())
+          ->GetInstalledExtension(extension_id);
+  if (!extension)
+    return v8::Null(isolate);
+
+  const extensions::PermissionSet& active =
+      extension->permissions_data()->active_permissions();
+  std::vector<std::string> api_names;
+  for (const extensions::APIPermission* permission : active.apis())
+    api_names.push_back(permission->name());
+  std::vector<std::string> origins;
+  for (const URLPattern& pattern : active.explicit_hosts())
+    origins.push_back(pattern.GetAsString());
+  return gin::DataObjectBuilder(isolate)
+      .Set("permissions", api_names)
+      .Set("origins", origins)
+      .Build();
+}
