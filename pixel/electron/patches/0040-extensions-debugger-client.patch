+namespace extensions {
+
+class Extension;
+
+// What chrome.debugger may attach to, as in Chrome's debugger_api.cc: any page
+// except other extensions' pages, file: URLs without file access, and URLs
+// extensions may never script (chrome:, the Web Store, ...). On failure
+// `error` holds Chrome's message.
+bool ExtensionMayDebugURL(const Extension& extension,
+                          content::BrowserContext* browser_context,
+                          const GURL& url,
+                          std::string* error);
+
+bool ExtensionMayDebugRenderFrameHost(
+    const Extension& extension,
+    content::BrowserContext* browser_context,
+    content::RenderFrameHost* render_frame_host,
+    std::string* error);
+
+}  // namespace extensions
