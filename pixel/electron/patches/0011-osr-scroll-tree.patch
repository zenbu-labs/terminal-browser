+v8::Local<v8::Value> ScrollTreeToV8(
+    v8::Isolate* isolate,
+    const std::vector<viz::ScrollTreeNode>& scroll_tree) {
+  v8::Local<v8::Array> nodes = v8::Array::New(isolate, scroll_tree.size());
+  for (size_t i = 0; i < scroll_tree.size(); ++i) {
+    const viz::ScrollTreeNode& node = scroll_tree[i];
+    gin::Dictionary dict(isolate, v8::Object::New(isolate));
+    dict.Set("elementId", static_cast<double>(node.element_id));
+    dict.Set("id", node.id);
+    dict.Set("parentId", node.parent_id);
+    dict.Set("transformId", node.transform_id);
+    dict.Set("containerScrollNodeId", node.container_scroll_node_id);
+    dict.Set("containerOrigin", node.container_origin);
+    dict.Set("containerBounds", node.container_bounds);
+    dict.Set("bounds", node.bounds);
+    dict.Set("scrollOffset", node.scroll_offset);
+    dict.Set("userScrollableHorizontal", node.user_scrollable_horizontal);
+    dict.Set("userScrollableVertical", node.user_scrollable_vertical);
+    dict.Set("isComposited", node.is_composited);
+    dict.Set("scrollsInnerViewport", node.scrolls_inner_viewport);
+    dict.Set("scrollsOuterViewport", node.scrolls_outer_viewport);
+    dict.Set("mainThreadRepaintReasons", node.main_thread_repaint_reasons);
+    dict.Set("toScreen", TransformToVector(node.to_screen));
+    dict.Set("containerToScreen", TransformToVector(node.container_to_screen));
+    nodes
+        ->Set(isolate->GetCurrentContext(), static_cast<uint32_t>(i),
+              ConvertToV8(isolate, dict))
+        .Check();
+  }
