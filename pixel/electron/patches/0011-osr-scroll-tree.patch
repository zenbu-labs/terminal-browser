+std::optional<std::vector<viz::ScrollTreeNode>> ScrollTree(
+    const media::mojom::VideoFrameInfo& info) {
+  if (!info.scroll_tree)
+    return std::nullopt;
+  std::vector<viz::ScrollTreeNode> nodes;
+  nodes.reserve(info.scroll_tree->size());
+  for (const auto& from : *info.scroll_tree) {
+    viz::ScrollTreeNode& node = nodes.emplace_back();
+    node.element_id = from->element_id;
+    node.id = from->id;
+    node.parent_id = from->parent_id;
+    node.transform_id = from->transform_id;
+    node.container_scroll_node_id = from->container_scroll_node_id;
+    node.container_origin = from->container_origin;
+    node.container_bounds = from->container_bounds;
+    node.bounds = from->bounds;
+    node.scroll_offset = from->scroll_offset;
+    node.user_scrollable_horizontal = from->user_scrollable_horizontal;
+    node.user_scrollable_vertical = from->user_scrollable_vertical;
+    node.is_composited = from->is_composited;
+    node.scrolls_inner_viewport = from->scrolls_inner_viewport;
+    node.scrolls_outer_viewport = from->scrolls_outer_viewport;
+    node.main_thread_repaint_reasons = from->main_thread_repaint_reasons;
+    node.to_screen = from->to_screen;
+    node.container_to_screen = from->container_to_screen;
+  }
+  return nodes;
+}
+
+std::optional<std::vector<viz::DrawnLayer>> DrawnLayers(
+    const media::mojom::VideoFrameInfo& info) {
+  if (!info.drawn_layers)
+    return std::nullopt;
+  std::vector<viz::DrawnLayer> layers;
+  layers.reserve(info.drawn_layers->size());
+  for (const auto& from : *info.drawn_layers) {
+    viz::DrawnLayer& layer = layers.emplace_back();
+    layer.layer_id = from->layer_id;
+    layer.element_id = from->element_id;
+    layer.screen_space_transform = from->screen_space_transform;
+    layer.rect = from->rect;
+    layer.scroll_node_id = from->scroll_node_id;
+    layer.transform_id = from->transform_id;
+    layer.contents_opaque = from->contents_opaque;
+  }
+  return layers;
+}
