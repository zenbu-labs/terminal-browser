@@ -0,0 +1,634 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Rob Pruzan <97781863+RobPruzan@users.noreply.github.com>
+Date: Fri, 20 Nov 2026 01:41:42 -0500
+Subject: feat: expose the compositor scroll tree and drawn layers with captured frames
+
+Carries the active tree's scroll nodes (cc names: element id, parent, container origin/bounds, content bounds, current offset, user-scrollable axes, is_composited, viewport flags, main-thread repaint reasons), the screen transforms of their contents and container, and the scroll node each container moves with, in viz::CompositorFrameMetadata, plus the drawn layers in draw order: layer id, element id, visible rect in frame pixels, screen-space transform, contents_opaque, and the scroll node each moves with (found by walking the transform tree to the nearest scroll transform; a stuck sticky box moves with the scroller it sticks in, anchor-positioned layers are marked -2, layers fixed to the frame -1). FrameSinkVideoCapturer copies them into VideoFrameInfo, so an offscreen consumer gets the exact scroll state of the frame it receives.
+
+diff --git a/cc/trees/layer_tree_host_impl.cc b/cc/trees/layer_tree_host_impl.cc
+index b1379146423335fd053a48bb74e2016d4ce65740..5653921354758952a7db8850d6e73a40d27c61bc 100644
+--- a/cc/trees/layer_tree_host_impl.cc
++++ b/cc/trees/layer_tree_host_impl.cc
+@@ -2579,6 +2579,122 @@ viz::CompositorFrameMetadata LayerTreeHostImpl::MakeCompositorFrameMetadata(
+     metadata.root_scroll_offset = active_tree_->TotalScrollOffset();
+   }
+ 
++  const ScrollTree& scroll_tree = active_tree_->property_trees()->scroll_tree();
++  const TransformTree& transform_tree =
++      active_tree_->property_trees()->transform_tree();
++  base::flat_map<int, int> scroll_node_of_transform;
++  for (int i = kSecondaryRootPropertyNodeId;
++       i < static_cast<int>(scroll_tree.size()); ++i) {
++    const ScrollNode& node = scroll_tree.Node(i);
++    if (node.transform_id > kRootPropertyNodeId) {
++      scroll_node_of_transform[node.transform_id] = node.id;
++    }
++  }
++  auto moves_with = [&](int transform_id) {
++    int skip = 0;
++    for (int id = transform_id; id > kRootPropertyNodeId;
++         id = transform_tree.Node(id).parent_id) {
++      const TransformNode& node = transform_tree.Node(id);
++      if (node.anchor_position_scroll_data_id != kInvalidPropertyNodeId) {
++        return -2;
++      }
++      if (node.sticky_position_constraint_id != kInvalidPropertyNodeId) {
++        const StickyPositionNodeData* sticky =
++            transform_tree.GetStickyPositionData(id);
++        if (sticky && !sticky->total_sticky_box_sticky_offset.IsZero()) {
++          skip = 1;
++        }
++      }
++      auto scroll = scroll_node_of_transform.find(id);
++      if (scroll == scroll_node_of_transform.end()) {
++        continue;
++      }
++      if (skip > 0) {
++        --skip;
++        continue;
++      }
++      return scroll->second;
++    }
++    return -1;
++  };
++  // Reported as the bits the reasons had when they were a uint32_t bitmask,
++  // so the value means the same whether cc stores a bitmask or an EnumSet.
++  auto repaint_reason_bits = [](const auto& reasons) -> uint32_t {
++    using Reasons = std::decay_t<decltype(reasons)>;
++    if constexpr (std::is_integral_v<Reasons>) {
++      return reasons;
++    } else {
++      using Reason = typename Reasons::EnumType;
++      uint32_t bits = 0;
++      if (reasons.Has(Reason::kHasBackgroundAttachmentFixedObjects)) {
++        bits |= 1u << 2;
++      }
++      if (reasons.Has(Reason::kNotOpaqueForTextAndLCDText)) {
++        bits |= 1u << 5;
++      }
++      if (reasons.Has(Reason::kPreferNonCompositedScrolling)) {
++        bits |= 1u << 15;
++      }
++      if (reasons.Has(Reason::kBackgroundNeedsRepaintOnScroll)) {
++        bits |= 1u << 16;
++      }
++      if (bits == 0 && !reasons.empty()) {
++        bits = 1u << 1;
++      }
++      return bits;
++    }
++  };
++  for (int i = kSecondaryRootPropertyNodeId;
++       i < static_cast<int>(scroll_tree.size()); ++i) {
++    const ScrollNode& node = scroll_tree.Node(i);
++    if (!node.element_id) {
++      continue;
++    }
++    viz::ScrollTreeNode& out = metadata.scroll_tree.emplace_back();
++    out.element_id = node.element_id.GetInternalValue();
++    out.id = node.id;
++    out.parent_id = node.parent_id;
++    out.container_origin = node.container_origin;
++    out.container_bounds = scroll_tree.container_bounds(node.id);
++    out.bounds = node.bounds;
++    out.scroll_offset = scroll_tree.current_scroll_offset(node.element_id);
++    out.user_scrollable_horizontal = node.user_scrollable_horizontal;
++    out.user_scrollable_vertical = node.user_scrollable_vertical;
++    out.is_composited = node.is_composited;
++    out.scrolls_inner_viewport = node.scrolls_inner_viewport;
++    out.scrolls_outer_viewport = node.scrolls_outer_viewport;
++    out.main_thread_repaint_reasons =
++        repaint_reason_bits(node.main_thread_repaint_reasons);
++    if (node.transform_id <= kRootPropertyNodeId ||
++        node.transform_id >= static_cast<int>(transform_tree.size())) {
++      continue;
++    }
++    const TransformNode& transform = transform_tree.Node(node.transform_id);
++    if (transform.parent_id == kInvalidPropertyNodeId) {
++      continue;
++    }
++    out.transform_id = transform.id;
++    out.to_screen = transform_tree.ToScreen(transform.id);
++    out.container_to_screen = transform_tree.ToScreen(transform.parent_id);
++    out.container_scroll_node_id = moves_with(transform.parent_id);
++  }
++
++  for (LayerImpl* layer : *active_tree_) {
++    if (!layer->contributes_to_drawn_render_surface() ||
++        !layer->draws_content() || layer->visible_layer_rect().IsEmpty()) {
++      continue;
++    }
++    viz::DrawnLayer& out = metadata.drawn_layers.emplace_back();
++    out.layer_id = layer->id();
++    out.element_id = layer->element_id().GetInternalValue();
++    out.screen_space_transform = layer->ScreenSpaceTransform();
++    out.rect = MathUtil::MapEnclosingClippedRect(out.screen_space_transform,
++                                                 layer->visible_layer_rect());
++    out.transform_id = layer->transform_tree_index();
++    out.contents_opaque = layer->contents_opaque();
++    out.scroll_node_id = moves_with(layer->transform_tree_index());
++  }
++
+   metadata.display_transform_hint = active_tree_->display_transform_hint();
+ 
+   metadata.is_mobile_optimized = IsMobileOptimized(active_tree_.get());
