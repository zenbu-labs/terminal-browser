+void OffScreenRenderWidgetHostView::SendKeyEvent(
+    const input::NativeWebKeyboardEvent& event) {
+  if (!render_widget_host_)
+    return;
+  // Send keys to the focused frame's render widget instead.
+  content::RenderWidgetHostImpl* target_host = render_widget_host_;
+  if (render_widget_host_->delegate()) {
+    target_host = render_widget_host_->delegate()->GetFocusedRenderWidgetHost(
+        render_widget_host_);
+  }
+  if (!target_host)
+    target_host = render_widget_host_;
+  target_host->ForwardKeyboardEvent(event);
+}
