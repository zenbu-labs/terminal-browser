+// The targets chrome.debugger.getTargets() lists, described the same way.
+base::ListValue Extensions::GetDebuggerTargets() {
+  base::ListValue targets;
+  for (const auto& host : content::DevToolsAgentHost::GetOrCreateAll()) {
+    const std::string& type = host->GetType();
+    if (type == content::DevToolsAgentHost::kTypeTab ||
+        (host->GetBrowserContext() &&
+         host->GetBrowserContext() != browser_context())) {
+      continue;
+    }
+    base::DictValue target;
+    target.Set("id", host->GetId());
+    target.Set("title", host->GetTitle());
+    target.Set("attached", host->IsAttached());
+    target.Set("url", host->GetURL().spec());
+    std::string target_type = "other";
+    // Like Chrome, a page is a tab or an extension page; other pages, such as
+    // DevTools windows, are "other".
+    int tab_id = type == content::DevToolsAgentHost::kTypePage
+                     ? extensions::GetElectronTabId(host->GetWebContents())
+                     : extension_misc::kUnknownTabId;
+    if (tab_id != extension_misc::kUnknownTabId) {
+      target.Set("tabId", tab_id);
+      target_type = "page";
+    } else if (type == content::DevToolsAgentHost::kTypePage &&
+               host->GetURL().SchemeIs(extensions::kExtensionScheme)) {
+      target.Set("extensionId", host->GetURL().GetHost());
+      target_type = "page";
+    } else if (type == content::DevToolsAgentHost::kTypeServiceWorker ||
+               type == content::DevToolsAgentHost::kTypeSharedWorker) {
+      target_type = "worker";
+    }
+    target.Set("type", target_type);
+    if (host->GetFaviconURL().is_valid())
+      target.Set("faviconUrl", host->GetFaviconURL().spec());
+    targets.Append(std::move(target));
+  }
+  return targets;
+}
