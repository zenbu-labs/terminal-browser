+// The app's own standard schemes (protocol.registerSchemesAsPrivileged) that
+// don't allow extensions hold the app's UI, which extensions may not script,
+// just as they may not script chrome:// pages in Chrome.
+class ElectronPermissionsPolicyDelegate
+    : public extensions::PermissionsData::PolicyDelegate {
+ public:
+  bool IsRestrictedUrl(const GURL& document_url, std::string* error) override {
+    if (!document_url.IsStandard() ||
+        URLPattern::IsValidSchemeForExtensions(
+            document_url.GetScheme())) {
+      return false;
+    }
+    const std::vector<std::string> app_schemes = base::SplitString(
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+            switches::kStandardSchemes),
+        ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+    if (std::ranges::find(app_schemes, document_url.GetScheme()) ==
+        app_schemes.end())
+      return false;
+    if (error)
+      *error = extensions::manifest_errors::kCannotAccessChromeUrl;
+    return true;
+  }
+};
