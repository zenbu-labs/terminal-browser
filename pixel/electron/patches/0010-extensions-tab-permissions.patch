+bool Extensions::GrantActiveTab(const std::string& extension_id,
+                                content::WebContents* web_contents) {
+  const extensions::Extension* extension =
+      extensions::ExtensionRegistry::Get(browser_context())
+          ->enabled_extensions()
+          .GetByID(extension_id);
+  auto* contents = web_contents ? WebContents::From(web_contents) : nullptr;
+  if (!extension || !contents ||
+      web_contents->GetBrowserContext() != browser_context())
+    return false;
+
+  if (auto* observer =
+          extensions::ElectronExtensionWebContentsObserver::FromWebContents(
+              web_contents)) {
+    web_contents->ForEachRenderFrameHost(
+        [observer](content::RenderFrameHost* render_frame_host) {
+          observer->SetTabIdForFrame(render_frame_host);
+        });
+  }
+
+  // Electron's extension APIs use the WebContents id as the tab id.
+  extensions::ActiveTabPermissionGranter::CreateForWebContents(
+      web_contents, contents->ID(), browser_context());
+  auto* granter =
+      extensions::ActiveTabPermissionGranter::FromWebContents(web_contents);
+  granter->GrantIfRequested(extension);
+  return granter->IsGranted(extension);
+}
+
+void Extensions::RevokeActiveTab(const std::string& extension_id,
+                                 content::WebContents* web_contents) {
+  if (!web_contents)
+    return;
+  auto* granter =
+      extensions::ActiveTabPermissionGranter::FromWebContents(web_contents);
+  if (granter)
+    granter->ClearActiveExtensionAndNotify(extension_id);
+}
