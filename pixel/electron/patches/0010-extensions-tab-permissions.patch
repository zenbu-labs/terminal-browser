+
+void ElectronExtensionWebContentsObserver::RenderFrameDeleted(
+    content::RenderFrameHost* render_frame_host) {
+  ExtensionWebContentsObserver::RenderFrameDeleted(render_frame_host);
+  frames_with_tab_id_.erase(render_frame_host->GetGlobalId());
+}
+
+void ElectronExtensionWebContentsObserver::SetTabIdForFrame(
+    content::RenderFrameHost* render_frame_host) {
+  auto* contents = electron::api::WebContents::From(web_contents());
+  if (!contents || !render_frame_host->IsRenderFrameLive() ||
+      frames_with_tab_id_.contains(render_frame_host->GetGlobalId()))
+    return;
+  if (auto* local_frame = GetLocalFrame(render_frame_host)) {
+    local_frame->SetTabId(contents->ID());
+    frames_with_tab_id_.insert(render_frame_host->GetGlobalId());
+  }
+}
