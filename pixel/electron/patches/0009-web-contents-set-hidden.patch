 }
 
+void WebContents::SetHidden(bool hidden) {
+  if (!hidden) {
+    web_contents()->WasShown();
+    return;
+  }
+  web_contents()->WasHidden();
+
+  // With background throttling off the widget ignores WasHidden() and keeps
+  // painting, but its view was hidden. Show the view again so the two agree,
+  // the same way SetBackgroundThrottling(false) keeps a hidden page painting.
+  auto* rfh = web_contents()->GetPrimaryMainFrame();
+  auto* rwhv = static_cast<content::RenderWidgetHostViewBase*>(
+      rfh ? rfh->GetView() : nullptr);
+  if (!rwhv || rwhv->IsShowing() || rwhv->IsRenderWidgetHostViewChildFrame() ||
+      rwhv->host()->IsHidden())
+    return;
+  rwhv->ShowWithVisibility(content::PageVisibilityState::kHiddenButPainting);
+  static_cast<content::RenderFrameHostImpl*>(rfh)->SetVisibilityForChildViews(
+      true);
+}
