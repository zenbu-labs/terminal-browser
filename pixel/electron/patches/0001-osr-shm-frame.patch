+// A software (shared memory) OSR frame exposed to JS without copying,
+// mirroring OffscreenSharedTextureValue. Only produced when the WebContents
+// was created with offscreen.useSharedMemory and the capturer delivered a
+// read-only shmem frame.
+struct OffscreenSoftwareFrameValue {
+  OffscreenSoftwareFrameValue();
+  ~OffscreenSoftwareFrameValue();
+  OffscreenSoftwareFrameValue(const OffscreenSoftwareFrameValue& other);
+
+  // It is user's responsibility to compose popup widget frames.
+  content::WidgetType widget_type = content::WidgetType::kFrame;
+
+  // The pixel format of the frame, matches the texture path naming.
+  media::VideoPixelFormat pixel_format = media::PIXEL_FORMAT_UNKNOWN;
+
+  // The full dimensions of the video frame data. Row stride corresponds to
+  // coded_size.width(), pixel rows start at offset 0 of the region.
+  gfx::Size coded_size;
+
+  // The populated region of the frame, its size is the drawable size.
+  gfx::Rect content_rect;
+
+  // Bytes per pixel row.
+  uint32_t stride = 0;
+
+  // Validated number of bytes backing content_rect.height() rows, never
+  // larger than the shared memory region.
+  uint64_t data_size = 0;
+
+  // The capture timestamp, microseconds since capture start
+  int64_t timestamp = 0;
+
+  // The frame count
+  int64_t frame_count = 0;
+
+  // Extra metadata for the video frame.
+  std::optional<gfx::Rect> capture_update_rect;
+  std::optional<gfx::Size> source_size;
+
+  // Releaser holder
+  raw_ptr<OffscreenReleaserHolder> releaser_holder = nullptr;
+
+#if BUILDFLAG(IS_LINUX)
+  // File descriptor of the shared memory region. Owned by releaser_holder,
+  // valid until release.
+  int fd = -1;
+#endif
+};
+
+typedef std::optional<OffscreenSoftwareFrameValue> OffscreenSoftwareFrame;
+
+typedef base::RepeatingCallback<void(const gfx::Rect&,
+                                     const SkBitmap&,
+                                     const OffscreenSharedTexture&,
+                                     const OffscreenSoftwareFrame&)>
     OnPaintCallback;
 
 }  // namespace electron
