+// Reads a {topLevelSite, hasCrossSiteAncestor} partition key. Without
+// hasCrossSiteAncestor, it is whether |url| is cross-site to the top-level
+// site, as in Chrome's cookies extension API.
+base::expected<net::CookiePartitionKey, std::string> ParsePartitionKey(
+    const base::DictValue& dict,
+    const std::string& top_level_site,
+    const GURL& url) {
+  bool has_cross_site_ancestor =
+      dict.FindBool("hasCrossSiteAncestor")
+          .value_or(url.is_valid() && net::SchemefulSite(url) !=
+                                          net::SchemefulSite(
+                                              GURL(top_level_site)));
+  return net::CookiePartitionKey::FromUntrustedInput(top_level_site,
+                                                     has_cross_site_ancestor);
+}
+
+// A partitionKey filter of null matches unpartitioned cookies only, one with
+// a topLevelSite matches the cookies of that partition only, and one without
+// a topLevelSite (or no partitionKey at all) matches every cookie.
+bool MatchesPartitionKey(const base::DictValue& filter,
+                         const net::CanonicalCookie& cookie) {
+  const base::Value* value = filter.Find("partitionKey");
+  if (!value)
+    return true;
+  if (value->is_none())
+    return !cookie.IsPartitioned();
+  if (!value->is_dict())
+    return false;
+  const std::string* top_level_site =
+      value->GetDict().FindString("topLevelSite");
+  if (!top_level_site)
+    return true;
+  const std::string* url = filter.FindString("url");
+  auto key = ParsePartitionKey(value->GetDict(), *top_level_site,
+                               GURL(url ? *url : ""));
+  return key.has_value() && cookie.PartitionKey() == *key;
+}
+
