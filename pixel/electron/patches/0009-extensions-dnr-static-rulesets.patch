+constexpr char kDNRIndexedVersionPref[] = "electron_dnr_indexed_version";
+constexpr char kDNREnabledStaticRulesetIDsPref[] = "dnr_enabled_ruleset_ids";
+
+bool IsSameIndexedVersion(ExtensionPrefs* prefs, const Extension& extension) {
+  std::string indexed_version;
+  return prefs->ReadPrefAsString(extension.id(), kDNRIndexedVersionPref,
+                                 &indexed_version) &&
+         indexed_version == extension.version().GetString();
+}
+
+// Loading an unpacked extension deletes its _metadata folder, which is where
+// Chromium keeps indexed rulesets, so the static rulesets are indexed again on
+// every load, like Chromium does when installing a CRX. When the extension has
+// enabled rulesets at runtime, every ruleset is indexed so edits to their JSON
+// take effect; if one of the others fails to index, only the manifest-enabled
+// ones are, as before, and Chromium reports the failure when it loads it.
+void IndexStaticRulesets(
+    scoped_refptr<const Extension> extension,
+    bool include_runtime_enabled,
+    base::OnceCallback<void(RulesetParseResult)> callback) {
+  using RulesetFilter =
+      declarative_net_request::FileBackedRulesetSource::RulesetFilter;
+  if (declarative_net_request::DNRManifestData::GetRulesets(*extension)
+          .empty()) {
+    std::move(callback).Run(RulesetParseResult());
+    return;
+  }
+  if (!include_runtime_enabled) {
+    declarative_net_request::InstallIndexHelper::IndexStaticRulesets(
+        *extension, RulesetFilter::kIncludeManifestEnabled,
+        declarative_net_request::RulesetSource::kNone, std::move(callback));
+    return;
+  }
+  declarative_net_request::InstallIndexHelper::IndexStaticRulesets(
+      *extension, RulesetFilter::kIncludeAll,
+      declarative_net_request::RulesetSource::kNone,
+      base::BindOnce(
+          [](scoped_refptr<const Extension> extension,
+             base::OnceCallback<void(RulesetParseResult)> callback,
+             RulesetParseResult result) {
+            if (result.error) {
+              IndexStaticRulesets(extension, false, std::move(callback));
+              return;
+            }
+            std::move(callback).Run(std::move(result));
+          },
+          extension, std::move(callback)));
+}
+
+// Merges freshly indexed ruleset checksums into the profile's prefs. Rulesets
+// enabled at runtime keep their checksums, so they load again after a restart,
+// and rulesets no longer in the manifest are forgotten. A new extension version
+// starts over from the manifest, like a Chrome update.
+void PersistRulesetPrefs(ExtensionPrefs* prefs,
+                         const Extension& extension,
+                         base::DictValue ruleset_install_prefs) {
+  const std::string version = extension.version().GetString();
+  bool same_version = IsSameIndexedVersion(prefs, extension);
+  std::set<declarative_net_request::RulesetID> manifest_ids;
+  for (const auto& info :
+       declarative_net_request::DNRManifestData::GetRulesets(extension)) {
+    manifest_ids.insert(info.id);
+  }
+
+  base::DictValue merged;
+  if (same_version) {
+    if (const base::DictValue* existing = prefs->ReadPrefAsDict(
+            extension.id(), ExtensionPrefs::kDNRStaticRulesetPref)) {
+      merged = existing->Clone();
+    }
+  } else {
+    prefs->UpdateExtensionPref(extension.id(), kDNREnabledStaticRulesetIDsPref,
+                               std::nullopt);
+  }
+  merged.Merge(std::move(ruleset_install_prefs));
+
+  // Forget rulesets the manifest no longer has.
+  std::vector<std::string> removed;
+  for (const auto [key, value] : merged) {
+    int id = 0;
+    if (!base::StringToInt(key, &id) ||
+        !manifest_ids.contains(declarative_net_request::RulesetID(id))) {
+      removed.push_back(key);
+    }
+  }
+  for (const auto& key : removed)
+    merged.Remove(key);
+  if (same_version) {
+    declarative_net_request::PrefsHelper helper(*prefs);
+    if (auto enabled = helper.GetEnabledStaticRulesets(extension.id())) {
+      std::erase_if(*enabled, [&manifest_ids](auto id) {
+        return !manifest_ids.contains(id);
+      });
+      helper.SetEnabledStaticRulesets(extension.id(), *enabled);
+    }
+  }
+
+  prefs->UpdateExtensionPref(
+      extension.id(), ExtensionPrefs::kDNRStaticRulesetPref,
+      merged.empty() ? std::nullopt
+                     : std::optional<base::Value>(std::move(merged)));
+  prefs->UpdateExtensionPref(extension.id(), kDNRIndexedVersionPref,
+                             base::Value(version));
+}
+
+void IndexStaticRulesetsAndReply(
+    ExtensionPrefs* prefs,
+    scoped_refptr<const Extension> extension,
+    base::OnceCallback<void(RulesetParseResult)> reply) {
+  bool has_runtime_enabled_rulesets =
+      IsSameIndexedVersion(prefs, *extension) &&
+      declarative_net_request::PrefsHelper(*prefs)
+          .GetEnabledStaticRulesets(extension->id())
+          .has_value();
+  GetExtensionFileTaskRunner()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          &IndexStaticRulesets, extension,
+          has_runtime_enabled_rulesets,
+          base::BindPostTask(base::SequencedTaskRunner::GetCurrentDefault(),
+                             std::move(reply))));
+}
