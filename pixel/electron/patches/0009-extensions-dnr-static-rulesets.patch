+constexpr char kDNRIndexedVersionPref[] = "electron_dnr_indexed_version";
+constexpr char kDNREnabledStaticRulesetIDsPref[] = "dnr_enabled_ruleset_ids";
+
+// Loading an unpacked extension deletes its _metadata folder, which is where
+// Chromium keeps indexed rulesets, so the manifest-enabled static rulesets are
+// indexed again on every load, like Chromium does when installing a CRX.
+void IndexStaticRulesets(
+    scoped_refptr<const Extension> extension,
+    base::OnceCallback<void(RulesetParseResult)> callback) {
+  if (declarative_net_request::DNRManifestData::GetRulesets(*extension)
+          .empty()) {
+    std::move(callback).Run(RulesetParseResult());
+    return;
+  }
+  declarative_net_request::InstallIndexHelper::IndexStaticRulesets(
+      *extension,
+      declarative_net_request::FileBackedRulesetSource::RulesetFilter::
+          kIncludeManifestEnabled,
+      declarative_net_request::RulesetSource::kNone, std::move(callback));
+}
+
+// Merges freshly indexed ruleset checksums into the profile's prefs. Rulesets
+// enabled at runtime keep their checksums, so they load again after a restart.
+// A new extension version starts over from the manifest, like a Chrome update.
+void PersistRulesetPrefs(ExtensionPrefs* prefs,
+                         const Extension& extension,
+                         base::DictValue ruleset_install_prefs) {
+  const std::string version = extension.version().GetString();
+  std::string indexed_version;
+  bool same_version =
+      prefs->ReadPrefAsString(extension.id(), kDNRIndexedVersionPref,
+                              &indexed_version) &&
+      indexed_version == version;
+
+  base::DictValue merged;
+  if (same_version) {
+    if (const base::DictValue* existing = prefs->ReadPrefAsDict(
+            extension.id(), ExtensionPrefs::kDNRStaticRulesetPref)) {
+      merged = existing->Clone();
+    }
+  } else {
+    prefs->UpdateExtensionPref(extension.id(), kDNREnabledStaticRulesetIDsPref,
+                               std::nullopt);
+  }
+  merged.Merge(std::move(ruleset_install_prefs));
+
+  prefs->UpdateExtensionPref(
+      extension.id(), ExtensionPrefs::kDNRStaticRulesetPref,
+      merged.empty() ? std::nullopt
+                     : std::optional<base::Value>(std::move(merged)));
+  prefs->UpdateExtensionPref(extension.id(), kDNRIndexedVersionPref,
+                             base::Value(version));
+}
+
+void IndexStaticRulesetsAndReply(
+    scoped_refptr<const Extension> extension,
+    base::OnceCallback<void(RulesetParseResult)> reply) {
+  GetExtensionFileTaskRunner()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          &IndexStaticRulesets, extension,
+          base::BindPostTask(base::SequencedTaskRunner::GetCurrentDefault(),
+                             std::move(reply))));
+}
+
