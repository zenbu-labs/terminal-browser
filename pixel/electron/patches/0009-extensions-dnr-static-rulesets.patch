+    LOG(ERROR) << "Reloading extension " << extension->id()
+               << " failed with: " << *ruleset_result.error;
+    return;
   }
+  PersistRulesetPrefs(ExtensionPrefs::Get(browser_context_), *extension,
+                      std::move(ruleset_result.ruleset_install_prefs));
