+#ifndef ELECTRON_SHELL_BROWSER_EXTENSIONS_API_PREFERENCE_PREFERENCE_API_H_
+#define ELECTRON_SHELL_BROWSER_EXTENSIONS_API_PREFERENCE_PREFERENCE_API_H_
+
+#include <memory>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "extensions/browser/browser_context_keyed_api_factory.h"
+#include "extensions/browser/event_router.h"
+#include "extensions/browser/extension_function.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/browser/extension_registry_observer.h"
+
+namespace extensions {
+
+// The browser side of the ChromeSetting type (chrome.proxy.settings): lets
+// extensions control browser preferences through the extension preference
+// store, and tells them when a setting changes.
+class ElectronPreferenceAPI : public BrowserContextKeyedAPI,
+                      public EventRouter::Observer,
+                      public ExtensionRegistryObserver {
+ public:
+  explicit ElectronPreferenceAPI(content::BrowserContext* context);
+  ElectronPreferenceAPI(const ElectronPreferenceAPI&) = delete;
+  ElectronPreferenceAPI& operator=(const ElectronPreferenceAPI&) = delete;
+  ~ElectronPreferenceAPI() override;
+
+  static BrowserContextKeyedAPIFactory<ElectronPreferenceAPI>* GetFactoryInstance();
+
+  // KeyedService:
+  void Shutdown() override;
+
+  // EventRouter::Observer:
+  void OnListenerAdded(const EventListenerInfo& details) override;
+
+  // ExtensionRegistryObserver:
+  void OnExtensionLoaded(content::BrowserContext* browser_context,
+                         const Extension* extension) override;
+  void OnExtensionUnloaded(content::BrowserContext* browser_context,
+                           const Extension* extension,
+                           UnloadedExtensionReason reason) override;
+  void OnExtensionUninstalled(content::BrowserContext* browser_context,
+                              const Extension* extension,
+                              UninstallReason reason) override;
+
+ private:
+  friend class BrowserContextKeyedAPIFactory<ElectronPreferenceAPI>;
+
+  void OnPrefChanged(const std::string& browser_pref);
+
+  // BrowserContextKeyedAPI:
+  static const char* service_name() { return "ElectronPreferenceAPI"; }
+  static const bool kServiceIsNULLWhileTesting = true;
+
+  raw_ptr<content::BrowserContext> browser_context_;
+  std::unique_ptr<PrefChangeRegistrar> registrar_;
+  base::ScopedObservation<ExtensionRegistry, ExtensionRegistryObserver>
+      registry_observation_{this};
+};
+
+template <>
+void BrowserContextKeyedAPIFactory<ElectronPreferenceAPI>::DeclareFactoryDependencies();
+
+class ElectronGetPreferenceFunction : public ExtensionFunction {
+ public:
+  DECLARE_EXTENSION_FUNCTION("types.ChromeSetting.get", TYPES_CHROMESETTING_GET)
+
+ protected:
+  ~ElectronGetPreferenceFunction() override = default;
+
+  // ExtensionFunction:
+  ResponseAction Run() override;
+};
+
+class ElectronSetPreferenceFunction : public ExtensionFunction {
+ public:
+  DECLARE_EXTENSION_FUNCTION("types.ChromeSetting.set", TYPES_CHROMESETTING_SET)
+
+ protected:
+  ~ElectronSetPreferenceFunction() override = default;
+
+  // ExtensionFunction:
+  ResponseAction Run() override;
+};
+
+class ElectronClearPreferenceFunction : public ExtensionFunction {
+ public:
+  DECLARE_EXTENSION_FUNCTION("types.ChromeSetting.clear",
+                             TYPES_CHROMESETTING_CLEAR)
+
+ protected:
+  ~ElectronClearPreferenceFunction() override = default;
+
+  // ExtensionFunction:
+  ResponseAction Run() override;
+};
+
+}  // namespace extensions
+
+#endif  // ELECTRON_SHELL_BROWSER_EXTENSIONS_API_PREFERENCE_PREFERENCE_API_H_
