+
+// Cross-process frames (the PDF viewer, site-isolated iframes) have their own
+// widgets. Chromium's input router hit-tests the compositor's surface tree to
+// find the widget under a point, so events must go through it whenever a
+// router exists and this view owns a compositor to hit-test against.
+bool OffScreenRenderWidgetHostView::ShouldRouteEvents() const {
+  if (!render_widget_host_ || !render_widget_host_->delegate())
+    return false;
+  if (!render_widget_host_->delegate()->IsWidgetForPrimaryMainFrame(
+          render_widget_host_)) {
+    return false;
+  }
+  if (!compositor_ || !compositor_->frame_sink_id().is_valid())
+    return false;
+  return !!render_widget_host_->delegate()->GetInputEventRouter();
+}
