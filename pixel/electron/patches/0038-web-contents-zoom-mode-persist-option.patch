-void WebContents::SetZoomMode(gin_helper::ErrorThrower thrower,
-                              const std::string& mode) {
-  auto zoom_mode = ParseZoomMode(mode);
+void WebContents::SetZoomMode(gin::Arguments* args) {
+  std::string mode;
+  std::optional<WebContentsZoomController::ZoomMode> zoom_mode;
+  if (args->GetNext(&mode))
+    zoom_mode = ParseZoomMode(mode);
   if (!zoom_mode) {
-    thrower.ThrowError(
-        "'zoomMode' must be 'default', 'isolated', 'manual', or 'disabled'");
+    gin_helper::ErrorThrower(args->isolate())
+        .ThrowError(
+            "'zoomMode' must be 'default', 'isolated', 'manual', or 'disabled'");
     return;
   }
+  bool persist = true;
+  if (gin_helper::Dictionary options; args->GetNext(&options))
+    options.Get("persist", &persist);
 
-  // When set via the Electron JS API, persist isolated/manual modes across
-  // navigations. The extensions API calls SetZoomMode on the controller
-  // directly and won't set this flag, preserving Chromium's default behavior.
+  // By default isolated/manual modes set from JS persist across navigations.
+  // With persist: false they reset to default on navigation, as Chromium's
+  // ZoomController (and so Chrome's tabs.setZoomSettings) does.
   GetZoomController()->SetPersistZoomMode(
-      *zoom_mode == WebContentsZoomController::ZOOM_MODE_ISOLATED ||
-      *zoom_mode == WebContentsZoomController::ZOOM_MODE_MANUAL);
+      persist && (*zoom_mode == WebContentsZoomController::ZOOM_MODE_ISOLATED ||
+                  *zoom_mode == WebContentsZoomController::ZOOM_MODE_MANUAL));
   GetZoomController()->SetZoomMode(*zoom_mode);
 }
 
