{
  "env": {
    "TTY7_PANE": "%3"
  },
  "exec": {
    "tty7 pane ls --json": "{\"panes\":[{\"pane\":3,\"workspace\":\"main\",\"tab\":\"1\"},{\"pane\":5,\"workspace\":\"main\",\"tab\":\"2\"}]}",
    "tty7 pane ls --all --json": "{\"panes\":[{\"pane\":3,\"title\":\"terminal-browser:90107-1\"},{\"pane\":5,\"title\":\"zsh\"},{\"pane\":9,\"title\":\"detached\"}]}",
    "tty7 split %3 --vertical --ratio 0.6 --json": "{\"pane\":11}",
    "tty7 send %11 terminal-browser open --enter": ""
  },
  "expect": {
    "name": "tty7",
    "currentPane": {
      "id": "3",
      "tab": "main:1"
    },
    "split": {
      "request": {
        "direction": "down",
        "command": [
          "terminal-browser",
          "open"
        ],
        "size": 0.4,
        "from": {
          "id": "3",
          "tab": "main:1"
        },
        "tty": null
      },
      "commands": [
        "tty7 split %3 --vertical --ratio 0.6 --json",
        "tty7 send %11 terminal-browser open --enter"
      ]
    },
    "pasteKey": {
      "commands": [
        "tty7 send %3 \u0016"
      ]
    }
  }
}
